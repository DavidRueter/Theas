# =========================
# Local / private
# =========================

# Underscore directories: _ai_use/, _scratchpad/, _testing/, ...
_*/

# Dot files and dot directories (.idea/, .vscode/, .env, .venv/, ...)
.*
!.gitignore
!.gitattributes

# Server config holds credentials. Also catches renamed copies and
# backups (settings2.cfg, settings.cfg.bak, settings_old.cfg, ...).
# SAMPLE_settings.cfg is the committed template and is not matched.
settings*

# Claude Code: shared project config is committed; personal overrides are not
!/.claude/
!/.claude/settings.json

# Scratch and backup folders
bak/
/bak2/
/debug/
/HTMLFiles/
/misc/
/scratchpad/
/stash/
test.txt
/test.bat


# =========================
# Python
# =========================

__pycache__/
*.py[cod]
venv/
venv_py*/
env/
ENV/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# =========================
# Build (PyInstaller)
# =========================

# dist/ is committed on purpose (see build_exe.bat); build/ is scratch
build/
*.manifest
*.spec
TheasServerSvc.spec2
TheasServer.exe
version.py
*.zip

# =========================
# Node
# =========================

/node_modules/

# =========================
# Logs
# =========================

/logs/
*.log

# =========================
# Windows
# =========================

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
